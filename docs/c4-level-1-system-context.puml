@startuml C4_Level_1_Telegram_Bot
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Level 1 — контекст системы Telegram-бота

LAYOUT_LEFT_RIGHT()

Person(user, "Пользователь Telegram", "Отправляет OBD-II код ошибки и получает его расшифровку.")

System(bot, "Telegram-бот расшифровки OBD-II", "Учебное приложение на Node.js. Ищет универсальный код в локальной базе и формирует ответ.")

System_Ext(telegram, "Telegram", "Доставляет сообщения пользователя боту и ответы бота пользователю через Bot API.")
System_Ext(cloudflare, "Cloudflare Quick Tunnel", "Даёт Telegram защищённый временный адрес для доступа к локальному приложению.")

Rel(user, telegram, "Отправляет код ошибки, читает ответ", "Telegram client")
Rel(telegram, cloudflare, "Передаёт webhook с сообщением", "HTTPS")
Rel(cloudflare, bot, "Перенаправляет webhook на локальный сервер", "HTTPS → localhost")
Rel(bot, telegram, "Отправляет расшифровку", "Telegram Bot API / HTTPS")

SHOW_LEGEND()
@enduml
