@startuml C4_Level_3_Telegram_Bot
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C4 Level 3 — компоненты приложения Telegram-бота

LAYOUT_TOP_DOWN()

Container_Ext(telegram, "Telegram", "Telegram Bot API", "Передаёт webhook и принимает ответы.")
ContainerDb_Ext(dtcData, "Локальная база DTC-кодов", "JSON-файл", "Хранит универсальные OBD-II коды.")

Container_Boundary(botApp, "Приложение бота (Node.js / Fastify)") {
  Component(webhookServer, "Webhook-сервер", "Fastify route", "Принимает POST /telegram/webhook и проверяет секретный заголовок.")
  Component(updateProcessor, "Обработчик Telegram Update", "Функция processTelegramUpdate", "Извлекает текст и данные чата из входящего сообщения.")
  Component(replyBuilder, "Формирование ответа", "Функция getDtcReply", "Проверяет формат OBD-II кода и строит текст ответа.")
  Component(dtcLoader, "Загрузка DTC-данных", "Функция loadDtcDatabase", "Один раз читает JSON-файл и создаёт Map кодов.")
  Component(messageSender, "Отправка сообщения", "Адаптер sendTelegramMessage", "Вызывает Telegram Bot API для отправки ответа.")
  Component(consoleOutput, "Вывод в консоль", "Функция printMessage", "Печатает входящее сообщение для разработки.")
}

Rel(telegram, webhookServer, "Передаёт Update", "Webhook / HTTPS")
Rel(webhookServer, updateProcessor, "Передаёт тело Update")
Rel(updateProcessor, replyBuilder, "Передаёт текст сообщения")
Rel(updateProcessor, consoleOutput, "Печатает сообщение")
Rel(replyBuilder, dtcLoader, "Ищет код")
Rel(dtcLoader, dtcData, "Загружает коды", "Файловая система")
Rel(updateProcessor, messageSender, "Передаёт chatId и ответ")
Rel(messageSender, telegram, "Отправляет сообщение", "Bot API / HTTPS")

SHOW_LEGEND()
@enduml
