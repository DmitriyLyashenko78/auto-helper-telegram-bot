{
  "name": "telegram-console-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Учебный Telegram-бот на Fastify без Telegram-библиотек",
  "scripts": {
    "start": "node --env-file=.env src/main.js",
    "dtc:build": "node --no-warnings scripts/build-dtc-data.js",
    "supabase:seed:build": "node scripts/build-supabase-seed.js",
    "webhook:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-webhook.ps1",
    "test": "node --test test/*.test.js",
    "test:deno": "deno test --config supabase/functions/deno.json supabase/functions",
    "lint:deno": "deno lint supabase/functions",
    "check:deno": "deno check --config supabase/functions/deno.json supabase/functions/telegram-webhook/index.ts supabase/functions/clients/index.ts supabase/functions/messages/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}
